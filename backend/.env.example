# ---------------------------------------------------------------------------
# Braintuitive - environment template
# Copy to backend/.env and fill in. Never commit the real .env.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# --- Server ----------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Security --------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-before-you-deploy
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- MongoDB Atlas (free tier) ---------------------------------------------
# Leave blank to run without document storage.
MONGODB_URI=
MONGODB_DB_NAME=braintuitive

# --- Nebius AI Studio ------------------------------------------------------
# https://studio.nebius.com/ -> API keys
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.studio.nebius.com/v1
# Model ids must match what your Nebius account exposes at GET /v1/models.
NEBIUS_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507
NEBIUS_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
# Must match the embedding model's output size and the Pinecone index dimension.
EMBEDDING_DIMENSIONS=4096

# --- Pinecone (free tier) --------------------------------------------------
PINECONE_API_KEY=
PINECONE_INDEX_NAME=braintuitive-curriculum
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- RAG tuning ------------------------------------------------------------
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=100
RETRIEVAL_TOP_K=5

# --- Question bank (pre-generation) -----------------------------------------
# Questions per sub-unit/difficulty slot. 30 = three fresh retries at 10/quiz.
BANK_DEPTH=30
# Fraction of the current unit a student must complete before the next unit
# begins pre-generating. 0.7 = "close to the end of the unit".
BANK_LOOKAHEAD_TRIGGER=0.7
# Questions generated per scheduled refill run.
BANK_REFILL_BUDGET=60

# --- Agents ----------------------------------------------------------------
AGENT_TIMEOUT=120
AGENT_MAX_ITERATIONS=8
AGENT_VERBOSE=true

# --- You.com search --------------------------------------------------------
YOU_API_KEY=

# --- Scheduler -------------------------------------------------------------
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=America/New_York
DAILY_REMINDER_HOUR=17

# --- Email (optional; leave blank to disable sending) ----------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@braintuitive.app
